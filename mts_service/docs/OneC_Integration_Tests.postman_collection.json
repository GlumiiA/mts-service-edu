{
  "info": {
    "name": "MTS Service — 1C Integration Tests",
    "description": "Тесты для интеграции с 1С (JCA интеграция, Quartz планировщик, сверка статусов, обработка ошибок)\n\nФункциональность:\n- Отправка заявки в 1С\n- Проверка статуса в 1С\n- Управление отклонениями (insufficient funds)\n- Ретраи неудачных попыток\n- Сверка статусов по расписанию\n- Управление ошибками и DLQ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Collection-level pre-request script: устанавливаем корректный Basic Authorization",
          "const username = pm.collectionVariables.get('adminEmail') || pm.variables.get('adminEmail') || pm.environment.get('adminEmail') || 'admin@test.com';",
          "const password = pm.collectionVariables.get('adminPassword') || pm.variables.get('adminPassword') || pm.environment.get('adminPassword') || 'password';",
          "const token = btoa(username + ':' + password);",
          "pm.request.headers.upsert({ key: 'Authorization', value: 'Basic ' + token });",
          "console.log('POSTMAN: Set Authorization header to Basic', token);"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "admin@test.com" },
    { "key": "adminPassword", "value": "password" },
    { "key": "userEmail", "value": "user@test.com" },
    { "key": "userPassword", "value": "password" },
    { "key": "applicationId", "value": "" },
    { "key": "syncHistoryId", "value": "" },
    { "key": "externalId", "value": "" },
    { "key": "rejectionId", "value": "" },
    { "key": "syncStatus", "value": "" }
  ],
  "item": [
    {
      "name": "1. Setup — Создание тестовой заявки",
      "item": [
        {
          "name": "Получить каталог (для tariffId)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog/mobile",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "mobile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const tariffs = pm.response.json();",
                  "if (tariffs.length > 0) {",
                  "  pm.collectionVariables.set('tariffId', tariffs[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать заявку",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tariffId\": 1,\n  \"address\": \"ул. Тестовая 123\",\n  \"additionalServices\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Use user credentials for creating applications (USER has APPLICATION_CREATE privilege)",
                  "const u = pm.collectionVariables.get('userEmail') || pm.environment.get('userEmail') || 'user@test.com';",
                  "const p = pm.collectionVariables.get('userPassword') || pm.environment.get('userPassword') || 'password';",
                  "const token = btoa(u + ':' + p);",
                  "pm.request.headers.upsert({ key: 'Authorization', value: 'Basic ' + token });",
                  "console.log('Set Authorization for create application to user:', u);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const app = pm.response.json();",
                  "pm.expect(app.id).to.be.a('number');",
                  "pm.collectionVariables.set('applicationId', app.id);",
                  "pm.collectionVariables.set('syncStatus', app.status);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. 1C Integration — Синхронизация",
      "item": [
        {
          "name": "Получить историю синхронизации для заявки",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/one-c/sync/application/{{applicationId}}?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "sync", "application", "{{applicationId}}"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const applicationId = pm.collectionVariables.get('applicationId');",
                  "pm.test('Application id is set', () => {",
                  "  pm.expect(applicationId, 'Сначала выполни Setup -> Создать заявку').to.not.be.empty;",
                  "});",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('Response contains content array', () => {",
                  "  pm.expect(page).to.have.property('content');",
                  "  pm.expect(page.content).to.be.an('array');",
                  "});",
                  "pm.test('At least one sync record is returned', () => {",
                  "  pm.expect(page.content.length, 'Сначала должен появиться sync в истории').to.be.greaterThan(0);",
                  "});",
                  "if (page.content.length > 0) {",
                  "  const sync = page.content[0];",
                  "  pm.expect(sync).to.have.property('id');",
                  "  pm.expect(sync).to.have.property('syncStatus');",
                  "  pm.expect(sync).to.have.property('createdAt');",
                  "  pm.collectionVariables.set('syncHistoryId', sync.id);",
                  "  pm.collectionVariables.set('externalId', sync.externalId);",
                  "  pm.collectionVariables.set('syncStatus', sync.syncStatus);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить синхронизацию по external ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/one-c/sync/external/{{externalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "sync", "external", "{{externalId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const externalId = pm.collectionVariables.get('externalId');",
                  "pm.test('External id is set', () => {",
                  "  pm.expect(externalId, 'Сначала получи externalId из истории синхронизации').to.not.be.empty;",
                  "});",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const sync = pm.response.json();",
                  "pm.test('Response matches externalId', () => {",
                  "  pm.expect(sync.externalId).to.eql(externalId);",
                  "});",
                  "pm.test('Sync has status', () => {",
                  "  pm.expect(sync).to.have.property('syncStatus');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Error Handling — Обработка ошибок",
      "item": [
        {
          "name": "Получить статистику ошибок",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/one-c/errors/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "errors", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const stats = pm.response.json();",
                  "pm.test('Response is an array', () => {",
                  "  pm.expect(stats).to.be.an('array');",
                  "});",
                  "pm.collectionVariables.set('errorStatsCount', String(stats.length));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Rejections — Управление отклонениями",
      "item": [
        {
          "name": "Получить все отклоненные заявки (ожидающие проверки)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/one-c/rejected?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "rejected"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('Response contains content array', () => {",
                  "  pm.expect(page).to.have.property('content');",
                  "  pm.expect(page.content).to.be.an('array');",
                  "});",
                  "pm.collectionVariables.set('rejectionsCount', String(page.content.length));",
                  "if (page.content.length > 0) {",
                  "  pm.expect(page.content[0]).to.have.property('id');",
                  "  pm.collectionVariables.set('rejectionId', page.content[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить количество заявок в ожидании проверки",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/one-c/rejected/count",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "rejected", "count"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const resp = pm.response.json();",
                  "pm.test('pendingReviewCount exists', () => {",
                  "  pm.expect(resp).to.have.property('pendingReviewCount');",
                  "  pm.expect(resp.pendingReviewCount).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('pendingReviewCount', String(resp.pendingReviewCount));"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить отклонения для конкретной заявки",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/one-c/rejected/application/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "rejected", "application", "{{applicationId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const rejections = pm.response.json();",
                  "pm.expect(rejections).to.be.an('array');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Retry & Reconciliation — Ретраи и сверка",
      "item": [
        {
          "name": "Вручную запустить ретрай для синхронизации",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/api/one-c/sync/{{syncHistoryId}}/retry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "sync", "{{syncHistoryId}}", "retry"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const syncHistoryId = pm.collectionVariables.get('syncHistoryId');",
                  "pm.test('Sync history id is set', () => {",
                  "  pm.expect(syncHistoryId, 'Сначала выполни запрос \"Получить историю синхронизации для заявки\"').to.not.be.empty;",
                  "});",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const resp = pm.response.json();",
                  "pm.test('Retry scheduled message', () => {",
                  "  pm.expect(resp).to.have.property('message');",
                  "  pm.expect(resp.message).to.eql('Retry scheduled');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Отметить отклонение как проверено",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Basic {{adminEmail}}:{{adminPassword}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewedBy\": \"manager@test.com\",\n  \"notes\": \"Reviewed and approved\",\n  \"approve\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/one-c/rejected/{{rejectionId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["api", "one-c", "rejected", "{{rejectionId}}", "review"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const rejectionId = pm.collectionVariables.get('rejectionId');",
                  "pm.test('Rejection id is set', () => {",
                  "  pm.expect(rejectionId, 'Сначала выполни запрос \"Получить все отклоненные заявки\"').to.not.be.empty;",
                  "});",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const resp = pm.response.json();",
                  "pm.test('Rejection reviewed message', () => {",
                  "  pm.expect(resp).to.have.property('message');",
                  "  pm.expect(resp.message).to.eql('Rejection reviewed');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Monitoring — Мониторинг",
      "item": [
        {
          "name": "Описание: Периодические операции",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "/**",
                  " * Периодические Job'ы, запущенные через Quartz:",
                  " *",
                  " * 1. OneCIntegrationRetryJob — каждые 5 минут",
                  " *    - Находит готовые к ретраю записи (PENDING, RETRY)",
                  " *    - Переотправляет в 1С",
                  " *    - Увеличивает retry count с экспоненциальным backoff",
                  " *    - Отправляет в DLQ если превышены max retries",
                  " *",
                  " * 2. OneCStatusReconciliationJob — каждые 30 минут",
                  " *    - Проверяет статус активных синхронизаций в 1С",
                  " *    - Выявляет зависшие/долго ожидающие записи",
                  " *    - Восстанавливается от сетевых ошибок",
                  " *",
                  " * Clustering:",
                  " * - JDBC JobStore гарантирует, что каждый job запускается только один раз",
                  " * - Несколько узлов могут делить один scheduler",
                  " * - Блокировки в БД предотвращают дублирование",
                  " */"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

