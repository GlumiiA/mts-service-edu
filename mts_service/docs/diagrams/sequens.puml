@startuml
title Асинхронное одобрение и подключение заявки (ЛР3)

actor "Менеджер" as Manager
participant "ApplicationController" as Api
participant "ApplicationService" as Service
participant "AMQP Producer" as Producer
queue "RabbitMQ Queue\n(application.approval.requested)" as Queue
participant "Worker Node #1\n@JmsListener" as Node1
participant "Worker Node #2\n@JmsListener" as Node2
database "mts_db" as MtsDb
database "billing_db" as BillingDb
participant "JCA 1C Adapter" as Jca
participant "1С (EIS)" as OneC
participant "Quartz Scheduler" as Quartz

== Инициация процесса ==
Manager -> Api : POST /applications/{id}/approve
Api -> Service : requestApprove(id)
Service -> Producer : publish ApprovalRequested
Producer -> Queue : message(applicationId, correlationId)
Service --> Api : 202 Accepted

== Асинхронная обработка на одном из узлов ==
alt сообщение забрал Node1
  Queue -> Node1 : ApprovalRequested
  Node1 -> Service : handleApproval(message)
else сообщение забрал Node2
  Queue -> Node2 : ApprovalRequested
  Node2 -> Service : handleApproval(message)
end

group JTA/XA транзакция
  Service -> MtsDb : lock application (PENDING)
  Service -> BillingDb : validate balance
  Service -> BillingDb : debit + billing_transaction
  Service -> MtsDb : update status -> APPROVED
end

Service -> Jca : createConnectionOrder(application)
Jca -> OneC : create order in 1C
OneC --> Jca : externalId / accepted
Jca --> Service : persisted integration state
Service -> MtsDb : mark integration=PENDING_SYNC

== Периодические операции ==
Quartz -> Service : retryFailed1CSync()
Service -> Jca : resend failed items
Jca -> OneC : retry send
OneC --> Jca : accepted/rejected
Jca --> Service : sync result

Quartz -> Service : reconcileStatuses()
Service -> Jca : getStatus(externalId)
Jca -> OneC : status request
OneC --> Jca : CONNECTED / IN_PROGRESS / FAILED
Jca --> Service : normalized status
Service -> MtsDb : update application status

@enduml
