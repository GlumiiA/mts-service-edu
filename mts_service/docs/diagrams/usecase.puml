@startuml
left to right direction

actor "Пользователь" as User
actor "Менеджер" as Manager
actor "Планировщик Quartz" as Quartz
actor "Система 1С (EIS)" as OneC

rectangle "ИС Каталог и ЛК пользователя (ЛР3)" {
  rectangle "Заявки и подключение" as Flow {
    (Подать заявку на подключение) as UC_Create
    (Запросить одобрение заявки) as UC_ApproveRequest
    (Асинхронно обработать одобрение) as UC_ApproveAsync
    (Списать средства и зафиксировать транзакцию) as UC_Billing
    (Передать команду подключения в 1С) as UC_Send1C
    (Получить финальный статус подключения) as UC_Connected
    (Отследить статус заявки в ЛК) as UC_Track
  }

  rectangle "Периодические операции" as Jobs {
    (Повторить неуспешную отправку в 1С) as UC_Retry1C
    (Сверить статусы заявок с 1С) as UC_Reconcile
  }
}

User --> UC_Create
User --> UC_Track

Manager --> UC_ApproveRequest
UC_ApproveRequest .> UC_ApproveAsync : <<include>>
UC_ApproveAsync .> UC_Billing : <<include>>
UC_ApproveAsync .> UC_Send1C : <<include>>
UC_Send1C .> UC_Connected : <<extend>>

Quartz --> UC_Retry1C
Quartz --> UC_Reconcile
UC_Retry1C .> UC_Send1C : <<include>>
UC_Reconcile .> UC_Connected : <<include>>

OneC --> UC_Send1C
OneC --> UC_Connected

@enduml
